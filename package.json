{
  "name": "pixelgate",
  "version": "0.1.0",
  "description": "Self-hosted visual regression testing bot: Playwright capture, pixel diff, static review report, CI/agent gate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2233admin/pixelgate.git"
  },
  "homepage": "https://github.com/2233admin/pixelgate#readme",
  "bugs": {
    "url": "https://github.com/2233admin/pixelgate/issues"
  },
  "type": "module",
  "bin": {
    "pixelgate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./playwright-reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "default": "./dist/playwright-reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "deps:check": "pnpm outdated",
    "deps:latest": "pnpm update --latest",
    "prepublishOnly": "pnpm build",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "visual-regression",
    "screenshot",
    "playwright",
    "storybook",
    "pixel-diff",
    "ci",
    "vite",
    "vitest"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "playwright": ">=1.50.0",
    "vite": ">=5.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "diff": "^9.0.0",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^8.0.0",
    "ssim.js": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
