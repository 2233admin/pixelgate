{
  "name": "pixelgate",
  "version": "0.1.0",
  "description": "Self-hosted visual regression testing bot: Playwright capture, pixel diff, static review report, CI/agent gate.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixelgate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "deps:check": "pnpm outdated",
    "deps:latest": "pnpm update --latest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "visual-regression",
    "screenshot",
    "playwright",
    "storybook",
    "pixel-diff",
    "ci",
    "vite",
    "vitest"
  ],
  "peerDependencies": {
    "playwright": ">=1.50.0",
    "vite": ">=6.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/browser-playwright": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "playwright": "^1.65.1"
  }
}
